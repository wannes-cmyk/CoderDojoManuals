---
// Testmoment: na elke stap klikt de ninja op de groene vlag.
interface Props { titel?: string }
const { titel = 'Test het' } = Astro.props;
---
<aside class="kader kader-test" aria-label={titel}>
  <p class="kader-titel">
    <svg class="vlag" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path d="M5 3v18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
      <path d="M5 4c4-2 6 2 10 0 2-1 3-1 4-1v10c-1 0-2 0-4 1-4 2-6-2-10 0z" fill="currentColor" />
    </svg>
    {titel}
  </p>
  <slot />
</aside>
